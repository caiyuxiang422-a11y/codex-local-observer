{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex 本地观察台",
  "version": "0.1.0",
  "identifier": "io.github.codex-local-observer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Codex 本地观察台",
        "width": 1120,
        "height": 780,
        "minWidth": 720,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true
      },
      {
        "label": "widget",
        "create": false,
        "url": "index.html?widget=1",
        "title": "Codex 项目概览",
        "width": 220,
        "height": 38,
        "minWidth": 1,
        "minHeight": 1,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "center": false,
        "focus": false,
        "focusable": false
      },
      {
        "label": "widget-crown",
        "create": false,
        "url": "index.html?crown=1",
        "title": "Codex 项目概览状态栏",
        "width": 560,
        "height": 32,
        "minWidth": 1,
        "minHeight": 1,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "center": false,
        "focus": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'",
      "devCsp": "default-src 'self' http://localhost:1420; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1421; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../THIRD_PARTY_LICENSES.txt": "THIRD_PARTY_LICENSES.txt"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
